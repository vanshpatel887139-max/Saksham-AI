# Backend configuration. Copy to backend/.env and fill in.
#   cp .env.example backend/.env
# backend/.env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase dashboard -> Project -> Connect -> OR use "Connection string".
# Use the *Session pooler* (port 5432) for a long-running server, or the
# *Transaction pooler* (port 6543) for serverless. Both are fine here because
# the backend holds a normal connection pool.
# For a local-only project, the direct connection string also works.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional. Connection pool sizing; defaults shown.
DB_POOL_MIN=1
DB_POOL_MAX=10

# Optional. Seconds to wait for a TCP connect, and for a checkout from the pool.
# Without a connect timeout a blackholed database host (firewall DROP rather than
# REJECT) leaves the handshake pending forever and the request thread never
# returns, so one bad packet drops the worker instead of producing a 500 the load
# balancer can route around. Keep this well under your platform's request timeout.
DB_CONNECT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Code execution (Virtual Labs)
# ---------------------------------------------------------------------------
# POST /api/labs/run executes caller-supplied Python. The subprocess limits
# (CPU/memory/file-descriptor caps and a timeout) are NOT a sandbox: the code
# can read any file the server can read, inherits the server's environment
# variables, and has unrestricted outbound network access — verified, not
# assumed. That means /api/labs/run is remote code execution, and on this
# backend it can reach DATABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
#
# It therefore requires a signed-in user, and is refused outright once
# SUPABASE_URL is set. So:
#   local demo, nothing configured        -> allowed
#   real Supabase backend configured      -> refused
#
# Do not "fix" a 503 from the labs page by setting this to true on a public
# deployment. To run untrusted code you need a separate container with no
# credentials, no network and a read-only filesystem. The correct fix is that,
# not this flag.
# ALLOW_CODE_EXECUTION=false
#
# Force it off even in local demo mode.
# DISABLE_CODE_EXECUTION=false

# ---------------------------------------------------------------------------
# Sign-in throttling
# ---------------------------------------------------------------------------
# /api/auth/login counts only FAILED attempts, on two axes: per client IP (stops
# one host spraying many accounts) and per email (stops a focused guessing run
# against one user). A correct password never consumes budget, so real users
# are never locked out. Exceeding either limit returns 429 with Retry-After.
#
# Per-process and in memory: with several replicas behind a load balancer each
# keeps its own counters, and everything resets on restart. That is fine for the
# single-process demo deployment. To make it global, move the counters to Redis
# (INCR + EXPIRE) — see backend/rate_limit.py.
RATE_LIMIT_LOGIN_MAX_PER_EMAIL=5
RATE_LIMIT_LOGIN_MAX_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Request limits & deployment
# ---------------------------------------------------------------------------
# Largest accepted quiz upload, in bytes (20 MB). Uploads are read in capped
# chunks, so an oversized file is refused as it streams rather than after it has
# been buffered in memory.
MAX_UPLOAD_BYTES=20971520

# Comma-separated Host header values the server will answer to. Leave EMPTY for
# local development. Set it in any real deployment, e.g.:
#   ALLOWED_HOSTS=saksham.example.com,api.saksham.example.com
# A request with any other Host is rejected with 400, which blocks Host-header
# poisoning of redirects and cached URLs. This is NOT a substitute for HTTPS --
# terminate TLS at your proxy or load balancer and redirect :80 to :443.
ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Project URL: dashboard -> Project Settings -> API.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Anon / publishable key. This is safe to use server-side and is the key the
# API uses to verify access tokens. Do NOT put the service_role key here.
SUPABASE_ANON_KEY=eyJ...

# Service role key. Used ONLY by scripts/seed_auth_users.py to create the demo
# Auth accounts, and it bypasses RLS entirely. Never expose it to the frontend,
# never commit it, and rotate it if it leaks.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared password for all 11 seeded demo accounts. Demo use only — every
# account has the same one, so this is not a secret worth protecting.
DEMO_USER_PASSWORD=change-me-for-the-demo

# Whether the PUBLIC /api/auth/demo-users endpoint echoes DEMO_USER_PASSWORD
# back to anonymous callers so the login screen can pre-fill it. Separate from
# DEMO_USER_PASSWORD on purpose: that variable is set for seeding, so testing
# it to decide whether to publish a credential makes "seeded" imply "safe to
# hand out", which is how it used to behave. Default off — leave it off for any
# deployment, and set it to true only for local demos.
# The identical string is also hardcoded in src/services/appService.ts for the
# offline (no-backend) login path, so this flag only controls what the API
# reveals, not what is knowable from the source.
EXPOSE_DEMO_PASSWORD=false

# Which seeded accounts the public /api/auth/demo-users endpoint lists, and so
# which buttons the login screen's "Demo accounts" picker offers. Comma
# separated, no quotes.
#
# The users table is seeded with 11 personas, but only these have a Supabase
# Auth identity — the rest were listed and could never complete a sign-in, so
# the picker advertised buttons that 401'd. Narrowing the list fixes that.
#
# This controls only what is DISPLAYED. It grants no access and blocks none:
# sign-in is still verified against Supabase Auth on every attempt, and an
# account omitted here can still authenticate if you supply its credentials.
# Leave unset to use the default shown here.
DEMO_ACCOUNT_IDS=admin-1,learner-1

# Which signed-in email addresses may be linked to a `users` row.
#
# Sign-in runs `UPDATE users SET auth_id = ... WHERE email = %s`, so the address
# in the credential is what chooses the account. Supabase projects have public
# sign-up ENABLED by default and the anon key is public by design, so anybody
# can create an auth account for an arbitrary address. The seeded personas use
# @sakshamai.demo, which GoTrue rejects as an invalid TLD — but that is luck,
# not a control, and it stops holding the moment a real domain is added.
# Anything not on this list is refused with a 403 after Supabase has already
# verified the password.
#
# Comma separated, no quotes. Blank falls back to the emails of the accounts in
# DEMO_ACCOUNT_IDS, so a misconfiguration fails closed rather than open.
AUTH_LINK_ALLOWLIST=admin-1@sakshamai.demo,learner-1@sakshamai.demo

# Which proxies uvicorn may trust for X-Forwarded-For. The sign-in rate limiter
# buckets on request.client.host, which is only the real client address if that
# header is honoured — and it is honoured only for a trusted proxy.
#
# Leave UNSET when running directly (the peer address is correct). Behind a
# platform proxy such as Render or a load balancer, set it, or every request
# looks like it came from the proxy: all users then share ONE rate-limit bucket
# and five failed sign-ins from anyone locks out everyone.
#
# Use the proxy's address or CIDR. Use '*' ONLY when the service genuinely
# cannot be reached except through that proxy — otherwise a client can forge
# the header and choose its own rate-limit bucket.
# FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------------------
# LLM (optional — every feature has a deterministic fallback)
# ---------------------------------------------------------------------------
# Get a key at https://console.groq.com. Without it the quiz generator, the
# AI Virtual Assistant and the iGOT learning plan fall back to hand-written
# logic and still work. The key is used server-side only and never sent to the
# browser.
# GROQ_API_KEY=gsk_...

# Model id. Free-tier keys may need a different model from the default.
# GROQ_MODEL=openai/gpt-oss-120b
# Free-tier alternatives: qwen/qwen3.8-27b, groq/compound

# ---------------------------------------------------------------------------
# Privacy controls
# ---------------------------------------------------------------------------
# What the AI Virtual Assistant sends to the LLM provider. With this OFF (the
# default) the advisor receives only what it needs to give advice: the officer's
# target role, competency levels, skill gaps, enrolments, recent quiz results and
# the chat itself. It does NOT receive the officer's name, email, employee id,
# department, education, experience or career goal.
#
# The name is never sent even if you turn this on — the model only ever needed it
# to choose a salutation, and it is now addressed by designation instead.
#
# Set this to true ONLY if you have a data-processing agreement with the LLM
# provider that permits sending employee background details to them. See
# docs/PRIVACY.md for the full field-by-field breakdown.
# ADVISOR_SHARE_PROFILE=false

# Write raw database and HTTP exception text to the logs. This is a local
# debugging aid and it is OFF by default because driver exception text can
# contain the values that caused the error — a psycopg unique violation on
# users.email embeds the email address. With it off, logs record only the
# exception class and SQLSTATE, which is enough to diagnose and cannot leak.
# Even with it on, emails, tokens, secrets and connection strings are still
# redacted. Never enable this where real user data flows.
# SAKSHAMAI_LOG_DEBUG=false

# Replace user ids in uvicorn's access log with "[redacted]". Three request
# targets carry one: /api/users/{id}, /api/quiz/history/{id}, and
# /api/courses?user_id={id}. A user id is pseudonymous, but it is a stable join
# key, and a log shipper plus a timestamp is enough to reconstruct who did what
# and when. The line itself is kept -- access logs are a legitimate control.
# Set false only when debugging one specific user.
ACCESS_LOG_REDACT=true

# Whether the session cookie gets the `Secure` attribute. Unset means "auto":
# Secure everywhere except when the request's Host is loopback, because a
# Secure cookie is silently dropped over plain HTTP and every request would
# 401. Leave it unset unless you terminate TLS somewhere unusual.
# COOKIE_SECURE=true

# Which mode this process runs in. "production" makes startup validation fatal:
# a missing critical variable, an unencrypted DATABASE_URL, a wildcard CORS
# origin or a published demo password all refuse to boot. Anything unrecognised
# is treated as production, so a typo fails closed rather than open.
# Leave unset for local development.
# SAKSHAMAI_ENV=production

# Content-Security-Policy overrides. Unset uses the built-in policy, which is
# already restrictive. Set these only to tighten it for a specific deployment;
# loosening them is how a CSP stops being a control.
# CSP_API=default-src 'self'; script-src 'self'; frame-ancestors 'none'
# CSP_FRONTEND=default-src 'self'; script-src 'self'; frame-ancestors 'none'

# LLM provider tuning. Only GROQ_API_KEY is required; these have working
# defaults and exist so a deployment can change model or timeout without a
# code change.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0.4
# GROQ_TIMEOUT=60

# Per-scope login throttles. Defaults: 5 per 60s per IP, 5 per 900s per email,
# 3 per 3600s for password reset. Override only to make them stricter.
# RATE_LIMIT_LOGIN_IP_MAX=5
# RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
# RATE_LIMIT_LOGIN_EMAIL_MAX=5
# RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
# RATE_LIMIT_PASSWORD_RESET_MAX=3
# RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600
# RATE_LIMIT_OTP_MAX=3
# RATE_LIMIT_OTP_WINDOW_SECONDS=3600

# Per-user daily cap on the LLM-costly generative routes (assistant chat, quiz
# generation incl. file uploads, competency assessment generation, iGOT plan,
# lab runs). One fixed UTC-day window per learner; counts additive calls, so a
# scripted burst burns at most the day's allowance of Groq tokens and rows.
# Default 30. Set 0 to disable entirely (not recommended on a public deployment).
LLM_DAILY_BUDGET=30

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated extra origins. The Vite dev/preview origins are always
# allowed; add your deployed frontend origin here.
# CORS_ORIGINS=https://sakshamai.example.gov.in

# ---------------------------------------------------------------------------
# Frontend (Vite — put these in a .env at the REPO ROOT, not backend/)
# ---------------------------------------------------------------------------
# VITE_API_URL is four-state, and the differences matter:
#
#   unset, `npm run dev`   -> http://localhost:8000. You are running the backend
#                             locally, so it is addressed directly.
#   unset, production build -> same-origin. This is the default on purpose.
#                             VITE_* values are inlined at build time, so an
#                             unset var would bake a literal
#                             http://localhost:8000 into the bundle; on Vercel
#                             every request would then be aimed at the visitor's
#                             own machine, fail as a network error, and the app
#                             would quietly fall back to mock data. Requiring an
#                             explicitly-empty value to avoid that is a trap,
#                             since "unset" and "empty" look alike in a
#                             dashboard. A production build therefore defaults
#                             to relative /api requests, which is what the /api
#                             rewrite in vercel.json provides.
#   empty                 -> same-origin, explicitly.
#   a URL                 -> used as-is, for an API you address directly.
#
# Do not set it to the Render URL on Vercel. The session cookie is
# SameSite=strict and SameSite compares *sites* (a registrable domain), not
# origins: vercel.app and onrender.com are different sites, so the browser
# withholds the cookie and every request comes back 401 with no error logged.
#
# In production, the Vercel origin must still be listed in CORS_ORIGINS above,
# because the CSRF origin guard checks the browser's Origin header on every
# state-changing cookie-authenticated request.
#
# VITE_API_URL=https://your-api.onrender.com

# ---------------------------------------------------------------------------
# Deployment (Vercel + Render + Supabase)
# ---------------------------------------------------------------------------
# Full walkthrough: docs/DEPLOYMENT.md
#
# vercel.json and render.yaml encode the whole setup. Two notes that are easy to
# get wrong when configuring by hand instead:
#
#   * The Vercel rewrite for /api/* must be listed BEFORE the SPA fallback.
#     Reversed, every API call returns index.html with HTTP 200.
#   * The Render service must run a single worker. The sign-in throttles and the
#     rate limiter keep counters in a per-process dict, so a second worker
#     silently doubles the effective limit. render.yaml sets WEB_CONCURRENCY=1
#     and startCommand deliberately omits --workers.
#
# On Vercel itself, no environment variables are needed for this architecture.

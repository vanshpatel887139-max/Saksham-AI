# Reference nginx configuration for a production deployment of SakshamAI.
#
# This file is an example, not a drop-in: the server_name, certificate paths
# and the API upstream all need to be filled in. It exists because the security
# headers that matter most for the *frontend* are set here, not in the backend
# — the FastAPI process cannot set headers on files it does not serve.
#
# Two things this deliberately does not do:
#
#   * It does not proxy the database. Postgres speaks its own protocol; there
#     is no way to "secure this with nginx" in front of a 5432 port. The
#     database must not be reachable from the internet at all — see the
#     deployment checklist in README.md.
#   * It does not set CORS. CORS is enforced by the API against an explicit
#     allow-list; repeating it here would create a second place to forget.

upstream sakshamai_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.example.gov.in;

    # Everything is redirected to TLS. This is also what makes the HSTS header
    # on the 443 server below meaningful: the browser only ever sees https.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.gov.in;

    # ----- TLS -----------------------------------------------------------
    # TLS 1.2 is the floor. 1.0/1.1 are broken and still accepted by clients
    # older than about 2019.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    ssl_certificate     /etc/letsencrypt/live/app.example.gov.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.gov.in/privkey.pem;

    # ----- security headers ---------------------------------------------
    # max-age is one year, per the deployment requirement. includeSubDomains
    # means a compromised sibling subdomain cannot be reached over plain HTTP
    # once the browser has seen this.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # The policy that matters. 'self' only: no inline script, no eval, no
    # third-party origin. A production React build needs none of those, so
    # anything that would require them is a bug rather than a workaround.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" always;

    # Do not advertise the nginx version.
    server_tokens off;

    root /srv/sakshamai/dist;
    index index.html;

    # ----- API -----------------------------------------------------------
    location /api/ {
        proxy_pass http://sakshamai_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The app reads the client IP for rate limiting, and it reads it from
        # X-Forwarded-For. That is only trustworthy because this proxy is the
        # only thing that can reach the API; if the API is ever exposed
        # directly, an attacker can forge the header and reset their own
        # per-IP budget at will. ALLOWED_HOSTS does not help here — see
        # uvicorn's --forwarded-allow-ips.
        proxy_set_header Connection "";
        proxy_read_timeout 120s;   # LLM-backed routes are slow by nature
        proxy_connect_timeout 10s;
    }

    # ----- static assets -------------------------------------------------
    # Vite emits content-hashed filenames, so these are safe to cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # index.html must never be cached: it is what points at the current
    # hashed bundles, and a stale copy pins users to a deleted build.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # Branding assets live in public/, so they keep stable filenames and are
    # NOT content-hashed -- a logo swap does not invalidate anything by itself.
    # Cache them for a week rather than forever so a replacement reaches people
    # without a redeploy.
    #
    # This block exists so a missing file returns a real 404. Without it the
    # `try_files $uri /index.html` below answers a request for
    # /branding/logo-full.svg with HTTP 200 and the whole SPA document, so the
    # browser reports a confusing decode error on an HTML body instead of a
    # missing file. Logo.tsx's SVG-to-PNG fallback still works either way, but
    # a genuine typo in a logo path should be obvious in the access log, not
    # look like a served file.
    location /branding/ {
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA history fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    client_max_body_size 25m;   # matches MAX_UPLOAD_BYTES

    # No directory listings, anywhere.
    autoindex off;
}
